msgstr "Discard button changes"

msgid "Limpar botão"
msgstr "Clear button"

# --- small window --------------------------------------------------------

msgid "Painel lateral"
msgstr "Side panel"

msgid "Ativar small window"
msgstr "Enable small window"

msgid "Usar modo de estatísticas (CPU e memória) no lugar do relógio"
msgstr "Use stats mode (CPU and memory) instead of the clock"

msgid "Estatísticas customizadas (1 a 3 itens)"
msgstr "Custom stats (1 to 3 items)"

msgid ""
"Deixe vazio para continuar usando o visor nativo do firmware. Quando você "
"selecionar itens aqui, o slot largo passa a ser renderizado pelo Linux."
msgstr ""
"Leave empty to keep the firmware's native display. Once you select items "
"here, the wide slot is rendered by Linux instead."

msgid "Intervalo (s)"
msgstr "Interval (s)"

msgid "Formato de hora"
msgstr "Time format"

msgid "Alternar relógio e estatísticas a cada (s)"
msgstr "Alternate clock and stats every (s)"

msgid "Cor de fundo"
msgstr "Background colour"

msgid "Operações"
msgstr "Operations"

