msgid "Ex.: streaming"
msgstr "e.g. streaming"

msgid "Ex.: Terminal"
msgstr "e.g. Terminal"

msgid "Abrir ou fechar o catálogo de ícones embutidos"
msgstr "Open or close the built-in icon catalogue"

msgid "Buscar por nome, app ou termo"
msgstr "Search by name, app or term"

msgid "Filtrar catálogo por estilo"
msgstr "Filter catalogue by style"

msgid "vazio = estatísticas fixas"
msgstr "empty = fixed stats"

